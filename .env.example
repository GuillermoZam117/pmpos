# SambaPOS Server Configuration
API_HOST=192.168.1.235
SAMBAPOS_API_URL=http://192.168.1.235:9000
SAMBAPOS_GRAPHQL_URL=http://192.168.1.235:9000/api/graphql
SAMBAPOS_TOKEN_URL=http://192.168.1.235:9000/Token

# SambaPOS Authentication
SAMBAPOS_USERNAME=Administrator
SAMBAPOS_PASSWORD=graphiql
SAMBAPOS_CLIENT_ID=pmpos

# Terminal Registration - CRITICAL: Must match SambaPOS configuration exactly
SAMBAPOS_TERMINAL=Server
SAMBAPOS_DEPARTMENT=Restaurant
SAMBAPOS_TICKET_TYPE=Ticket
SAMBAPOS_MENU=Menu

# Application Settings
NODE_ENV=development
DEBUG=pmpos:*
REACT_APP_DEBUG=true

# Terminal Registration Control
REACT_APP_SKIP_TERMINAL_REGISTER=true

# Instructions:
# 1. Copy this file to .env
# 2. Update API_HOST with your SambaPOS server IP
# 3. Verify SAMBAPOS_TERMINAL, DEPARTMENT, TICKET_TYPE match your SambaPOS setup exactly
# 4. Test with GraphiQL: mutation {registerTerminal(ticketType:"Ticket", terminal:"Server", department:"Restaurant", user:"Administrator")}