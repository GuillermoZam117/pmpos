# ==============================================
# SambaPOS Server Configuration (Fully Configurable)
# ==============================================

# Auto-discovery configuration - cleaner approach
# Leave SAMBAPOS_API_URL empty to enable auto-discovery
# SAMBAPOS_API_URL=

# Server identification (priority order)
# Option 1: Use Windows server name (recommended)
SAMBAPOS_SERVER_NAME=Arenso_09

# Option 2: Use direct IP (fallback)
API_HOST=192.168.1.235
SAMBAPOS_API_PORT=9000

# Option 3: Full URL override (highest priority)
SAMBAPOS_API_URL=http://192.168.1.235:9000

# Additional server names to try (comma-separated)
# SAMBAPOS_ADDITIONAL_SERVERS=SAMBAPOS-SERVER,POS,RESTAURANTE

# Auto-discovery ports to test (comma-separated)
# SAMBAPOS_DISCOVERY_PORTS=9000,8080,3000

# ==============================================
# SambaPOS Authentication (Fully Configurable)  
# ==============================================
SAMBAPOS_USERNAME=graphiql
SAMBAPOS_PASSWORD=graphiql
SAMBAPOS_CLIENT_ID=graphiql

# ==============================================
# Terminal Configuration (Fully Configurable)
# ==============================================
# These values must match your SambaPOS configuration exactly
SAMBAPOS_TERMINAL=SERVIDOR
SAMBAPOS_DEPARTMENT=MESAS
SAMBAPOS_TICKET_TYPE=COMEDOR
SAMBAPOS_ENTITY_TYPE=Mesas
SAMBAPOS_ENTITY_SCREEN=MESAS
SAMBAPOS_MENU=MENU

# ==============================================
# Application Settings (Fully Configurable)
# ==============================================
# SAMBAPOS_AUTO_CONNECT_PRINTER=true
# SAMBAPOS_DEFAULT_PRINTER=CAJA
# SAMBAPOS_TABLE_VIEW=true
# SAMBAPOS_SHOW_ORDER_TAGS=true
# SAMBAPOS_ALLOW_SPLIT_BILL=true
# SAMBAPOS_ALLOW_MERGE_TICKETS=true

# ==============================================
# Timeouts and Performance (Fully Configurable)
# ==============================================
# SAMBAPOS_CONNECTION_TIMEOUT=30000
# SAMBAPOS_REFRESH_INTERVAL=5000
# SAMBAPOS_REQUEST_TIMEOUT=20000
# SAMBAPOS_TOKEN_VALIDITY=31536000000
# SAMBAPOS_REFRESH_THRESHOLD=604800000

# ==============================================
# Application Environment
# ==============================================
NODE_ENV=development
DEBUG=pmpos:*
REACT_APP_DEBUG=true

# ==============================================
# Read Service Configuration (Optional SQL API)
# ==============================================
# READ_SERVICE_URL=http://localhost:4005
# READ_SERVICE_APIKEY=test-key-123
# REACT_APP_USE_SQL_READS=true

# ==============================================
# Command Names (Fully Configurable - match your SambaPOS)
# ==============================================
SAMBAPOS_PRINT_JOB_NAME=Imprimir factura CAJA
SAMBAPOS_SUBMIT_ORDERS_COMMAND=Cerrar Ticket
SAMBAPOS_ORDER_COMMENT_COMMAND=TagOrder
SAMBAPOS_AUTOCMD_GIFT=Regalo
SAMBAPOS_AUTOCMD_VOID=Anular
SAMBAPOS_PRINT_ACCOUNT_COMMAND=Imprimir factura

# ==============================================
# Token Storage (Fully Configurable)
# ==============================================
# SAMBAPOS_TOKEN_STORAGE_KEY=sambapos_token_encrypted
# SAMBAPOS_TOKEN_EXPIRY_KEY=sambapos_token_expiry