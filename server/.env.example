# ========================================
# PMPOS Read Service - Environment Variables
# ========================================

# ---- SambaPOS MSSQL (Read-Only) ----
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=SambaPOS5
MSSQL_USER=sa
MSSQL_PASSWORD=your_password_here
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# ---- PostgreSQL (PMPOS Own Database) ----
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=pmpos_db
PG_USER=pmpos
PG_PASSWORD=your_secure_password_here
PG_SSL=false

# PostgreSQL Pool Configuration
PG_POOL_MAX=20
PG_POOL_MIN=5
PG_IDLE_TIMEOUT=30000
PG_CONNECTION_TIMEOUT=10000

# ---- Server Configuration ----
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# ---- Cache Configuration ----
CACHE_TTL=300
CACHE_CHECK_PERIOD=60

# ---- CORS Configuration ----
CORS_ORIGIN=http://localhost:8080

# ---- API Keys (para futuro uso) ----
# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# MercadoPago Credentials
MP_ACCESS_TOKEN=your_mp_access_token_here
MP_PUBLIC_KEY=your_mp_public_key_here
MP_ENVIRONMENT=sandbox

# WhatsApp Bot (futuro)
WHATSAPP_SESSION_PATH=./whatsapp-session
WHATSAPP_ENABLED=false
